# Copy to .env to change defaults. SOC tools are NOT configured here:
# connect them from the dashboard (Integrations → Connect a tool).

# Demo mode adds nine simulated tools with a realistic attack story. Set to 0 for production.
CYBERUNIFY_DEMO=1

# How long logs are kept and shown, and how often pull integrations are polled.
WINDOW_HOURS=168
INGEST_INTERVAL_SECONDS=60

# Protect the dashboard with a login (user name can be anything). Webhooks use their own token.
CYBERUNIFY_ADMIN_PASSWORD=

# The address tools use to reach this server (shown in webhook URLs).
PUBLIC_URL=http://localhost:8000

# Interface the syslog receivers listen on.
SYSLOG_BIND=0.0.0.0

# Key that encrypts stored credentials. If unset, one is generated into .cyberunify.key.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CYBERUNIFY_SECRET_KEY=

# Asset criticality (1.0 normal … 2.0 crown jewels) and IP/alias → asset name inventory.
ASSET_CRITICALITY=web-01=1.5,db-01=1.5,dc-01=1.6
ASSET_INVENTORY=10.0.1.10=web-01,10.0.2.20=db-01,10.0.0.5=dc-01,shop.example.com=web-01
