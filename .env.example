# Copy to .env and fill in what you have. Leave a connector's URL empty to disable it.

# Demo mode generates a realistic attack scenario (works with no SOC tools at all).
# Turn it off once real connectors are configured.
CYBERUNIFY_DEMO=1

# How far back the dashboard looks, and how often to pull new alerts (0 = only on demand).
WINDOW_HOURS=168
INGEST_INTERVAL_SECONDS=300

# Host criticality (1.0 normal, up to 2.0 for crown jewels) and IP → hostname inventory.
ASSET_CRITICALITY=web-01=1.5,db-01=1.5,dc-01=1.6
ASSET_INVENTORY=10.0.1.10=web-01,10.0.2.20=db-01,10.0.0.5=dc-01

# --- Wazuh (alerts are read from the Wazuh indexer / OpenSearch) ---
WAZUH_INDEXER_URL=
# e.g. https://wazuh-indexer.local:9200
WAZUH_USER=admin
WAZUH_PASSWORD=
WAZUH_INDEX=wazuh-alerts-*
WAZUH_VERIFY_TLS=true

# --- Elasticsearch / ELK (ECS documents) ---
ELASTIC_URL=
# e.g. https://elastic.local:9200
ELASTIC_API_KEY=
ELASTIC_INDEX=.alerts-security.alerts-default
ELASTIC_VERIFY_TLS=true

# --- Suricata (path to eve.json) ---
SURICATA_EVE_PATH=
# e.g. /var/log/suricata/eve.json
